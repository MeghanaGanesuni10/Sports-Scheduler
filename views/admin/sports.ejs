<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container">
  <%- include('../partials/flash') %>

  <div class="flex-between mb-1">
    <div>
      <h1 class="page-title" style="margin-bottom: 0;">All Sports</h1>
      <p class="page-subtitle">Sports available in the platform for creating sessions.</p>
    </div>
    <a href="/admin/sports/create" class="btn btn-primary">+ Create Sport</a>
  </div>

  <% if (sports && sports.length > 0) { %>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Sport Name</th>
            <th>Created By</th>
            <th>Created Date</th>
          </tr>
        </thead>
        <tbody>
          <% sports.forEach(sport => { %>
            <tr>
              <td><strong><%= sport.name %></strong></td>
              <td><%= sport.createdBy ? sport.createdBy.name : 'Unknown' %></td>
              <td><%= new Date(sport.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="card empty-state">
      <div class="empty-icon">⚽</div>
      <p>No sports have been created yet.</p>
      <a href="/admin/sports/create" class="btn btn-primary btn-sm">Create First Sport</a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
