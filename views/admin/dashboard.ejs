<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container">
  <%- include('../partials/flash') %>

  <div class="dashboard-header-block card pastel-amber mb-2" style="border: 2px solid #fde047;">
    <div>
      <h1 class="page-title">👑 Admin Dashboard & Analytics</h1>
      <p class="page-subtitle" style="margin-bottom: 0;">Welcome back, <strong><%= currentUser.name %></strong>! System metrics, reports, and sport management overview.</p>
    </div>

    <div class="actions-row mb-0">
      <a href="/admin/sports/create" class="btn btn-primary">+ Create Sport</a>
      <a href="/sessions/create" class="btn btn-success">+ Create Session</a>
      <a href="/admin/reports" class="btn btn-outline">📊 Full Reports</a>
      <a href="/admin/sports" class="btn btn-outline">⚽ All Sports</a>
    </div>
  </div>

  <!-- Key Metrics Stat Cards (Pastel Theme) -->
  <div class="stats-grid">
    <div class="stat-card pastel-indigo">
      <div class="stat-card-header">
        <div class="stat-icon-badge">⚽</div>
        <span class="badge badge-joined">Sports</span>
      </div>
      <div>
        <div class="stat-value"><%= typeof totalSportsCount !== 'undefined' ? totalSportsCount : 0 %></div>
        <div class="stat-label">Total Sports Managed</div>
      </div>
    </div>

    <div class="stat-card pastel-mint">
      <div class="stat-card-header">
        <div class="stat-icon-badge">📅</div>
        <span class="badge badge-active">Active</span>
      </div>
      <div>
        <div class="stat-value" style="color: var(--color-success);"><%= typeof activeSessions !== 'undefined' ? activeSessions : 0 %></div>
        <div class="stat-label">Active Sessions</div>
      </div>
    </div>

    <div class="stat-card pastel-amber">
      <div class="stat-card-header">
        <div class="stat-icon-badge">🏏</div>
        <span class="badge badge-completed">Total</span>
      </div>
      <div>
        <div class="stat-value" style="color: var(--color-warning);"><%= typeof totalSessions !== 'undefined' ? totalSessions : 0 %></div>
        <div class="stat-label">Total Sessions Scheduled</div>
      </div>
    </div>

    <div class="stat-card pastel-sky">
      <div class="stat-card-header">
        <div class="stat-icon-badge">👥</div>
        <span class="badge badge-joined">Players</span>
      </div>
      <div>
        <div class="stat-value" style="color: var(--color-primary);"><%= typeof totalPlayers !== 'undefined' ? totalPlayers : 0 %></div>
        <div class="stat-label">Registered Players</div>
      </div>
    </div>

    <div class="stat-card pastel-coral">
      <div class="stat-card-header">
        <div class="stat-icon-badge">🏆</div>
        <span class="badge badge-full">Joins</span>
      </div>
      <div>
        <div class="stat-value" style="color: var(--color-danger);"><%= typeof totalEnrollments !== 'undefined' ? totalEnrollments : 0 %></div>
        <div class="stat-label">Total Session Joins</div>
      </div>
    </div>
  </div>

  <!-- Analytics & Reports Section -->
  <div class="analytics-grid mb-2">
    <!-- Sport Popularity Analytics -->
    <div class="card">
      <h2 class="section-title">📊 Sport Session Popularity</h2>
      <p class="form-text mb-15">Breakdown of scheduled sessions by sport</p>

      <% if (typeof sportPopularity !== 'undefined' && sportPopularity.length > 0) { %>
        <div class="popularity-bar-container">
          <% sportPopularity.forEach(sport => { %>
            <div class="popularity-item">
              <div class="popularity-label">
                <strong><%= sport.name %></strong>
                <span class="text-muted"><%= sport.count %> session<%= sport.count !== 1 ? 's' : '' %> (<%= sport.pct %>%)</span>
              </div>
              <div class="popularity-bar-bg">
                <div class="popularity-bar" style="width: <%= Math.max(sport.pct, 8) %>%;">
                  <span class="popularity-count"><%= sport.count %></span>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <p>No sport analytics data available yet. Create your first sport session!</p>
        </div>
      <% } %>
    </div>

    <!-- Session Status Distribution -->
    <div class="card">
      <h2 class="section-title">📈 Session Status Breakdown</h2>
      <p class="form-text mb-15">Current status distribution across all sports</p>

      <div class="status-metrics-list">
        <% 
          const tot = totalSessions || 1;
          const activePct = Math.round(((activeSessions || 0) / tot) * 100);
          const completedPct = Math.round(((completedSessions || 0) / tot) * 100);
          const cancelledPct = Math.round(((cancelledSessions || 0) / tot) * 100);
        %>

        <div class="status-metric-row">
          <div class="status-metric-header">
            <span><span class="status-dot green"></span> Active Sessions</span>
            <strong><%= activeSessions || 0 %> (<%= activePct %>%)</strong>
          </div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill green" style="width: <%= activePct %>%;"></div>
          </div>
        </div>

        <div class="status-metric-row">
          <div class="status-metric-header">
            <span><span class="status-dot blue"></span> Completed / Past</span>
            <strong><%= completedSessions || 0 %> (<%= completedPct %>%)</strong>
          </div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill blue" style="width: <%= completedPct %>%;"></div>
          </div>
        </div>

        <div class="status-metric-row">
          <div class="status-metric-header">
            <span><span class="status-dot red"></span> Cancelled Sessions</span>
            <strong><%= cancelledSessions || 0 %> (<%= cancelledPct %>%)</strong>
          </div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill red" style="width: <%= cancelledPct %>%;"></div>
          </div>
        </div>
      </div>

      <!-- Quick Date Filter Form -->
      <div class="quick-report-box mt-2">
        <h4 style="font-size: var(--font-size-sm); font-weight: 700; margin-bottom: 0.5rem;">📅 Custom Date Range Analytics Report</h4>
        <form action="/admin/reports" method="GET" class="flex gap-1 flex-wrap align-center">
          <input type="date" name="from" class="form-control form-control-sm" required style="flex: 1; min-width: 130px;">
          <input type="date" name="to" class="form-control form-control-sm" required style="flex: 1; min-width: 130px;">
          <button type="submit" class="btn btn-primary btn-sm">Generate Report</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Recent Sessions Log -->
  <div class="card mb-2">
    <div class="flex justify-between align-center mb-1">
      <h2 class="section-title mb-0">⏱️ Recent Sessions Overview</h2>
      <a href="/sessions" class="btn btn-outline btn-sm">View All Sessions ➔</a>
    </div>

    <% if (typeof recentSessions !== 'undefined' && recentSessions.length > 0) { %>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Sport</th>
              <th>Venue</th>
              <th>Date & Time</th>
              <th>Players Joined</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% recentSessions.forEach(session => { %>
              <tr>
                <td><strong><%= session.sport ? session.sport.name : 'Unspecified' %></strong></td>
                <td><%= session.venue %></td>
                <td>
                  <%= new Date(session.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  at <%= session.time %>
                </td>
                <td>
                  <span class="badge badge-joined">
                    <%= session.players ? session.players.length : 0 %> / <%= session.maxPlayers %>
                  </span>
                </td>
                <td>
                  <% if (session.status === 'active') { %>
                    <span class="badge badge-active">Active</span>
                  <% } else if (session.status === 'cancelled') { %>
                    <span class="badge badge-cancelled">Cancelled</span>
                  <% } else { %>
                    <span class="badge badge-completed">Completed</span>
                  <% } %>
                </td>
                <td>
                  <a href="/sessions/<%= session._id %>" class="btn btn-outline btn-sm">Details</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>No sessions recorded in the system yet.</p>
        <a href="/sessions/create" class="btn btn-success btn-sm mt-1">+ Create First Session</a>
      </div>
    <% } %>
  </div>

  <!-- Sports Created By You Table -->
  <div class="card">
    <div class="flex justify-between align-center mb-1">
      <h2 class="section-title mb-0">🏆 Sports Managed By You</h2>
      <a href="/admin/sports/create" class="btn btn-primary btn-sm">+ Add New Sport</a>
    </div>

    <% if (sports && sports.length > 0) { %>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Sport Name</th>
              <th>Created Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% sports.forEach(sport => { %>
              <tr>
                <td><strong><%= sport.name %></strong></td>
                <td><%= new Date(sport.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                <td>
                  <a href="/sessions/create?sport=<%= sport._id %>" class="btn btn-outline btn-sm">Create Session</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-icon">⚽</div>
        <p>You haven't created any sports yet.</p>
        <a href="/admin/sports/create" class="btn btn-primary btn-sm">Create Your First Sport</a>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
