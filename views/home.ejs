<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="hero">
  <div class="hero-content">
    <div class="hero-icon">🏆</div>
    <h1>Sports Scheduler</h1>
    <p>Organize sports sessions, invite players, manage venues, and track activity seamlessly in one place.</p>

    <div class="hero-actions">
      <% if (!currentUser) { %>
        <a href="/signup" class="btn btn-primary btn-lg">Get Started</a>
        <a href="/login" class="btn btn-outline btn-lg">Log In</a>
      <% } else { %>
        <a href="/dashboard" class="btn btn-primary btn-lg">Go to Dashboard</a>
        <a href="/sessions" class="btn btn-outline btn-lg">Browse Sessions</a>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
