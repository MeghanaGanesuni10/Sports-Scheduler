<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container">
  <%- include('../partials/flash') %>

  <div class="card pastel-amber mb-2" style="border: 2px solid #fde047;">
    <h1 class="page-title">⚽ Player Dashboard</h1>
    <p class="page-subtitle" style="margin-bottom: 0;">Welcome back, <strong><%= currentUser.name %></strong>! Organize, schedule, and join sports sessions.</p>
  </div>

  <div class="stats-grid">
    <div class="stat-card pastel-indigo">
      <div class="stat-card-header">
        <div class="stat-icon-badge">⚽</div>
        <span class="badge badge-active">Available</span>
      </div>
      <div>
        <div class="stat-value"><%= typeof availableCount !== 'undefined' ? availableCount : 0 %></div>
        <div class="stat-label">Available Sessions</div>
      </div>
    </div>

    <div class="stat-card pastel-mint">
      <div class="stat-card-header">
        <div class="stat-icon-badge">🏏</div>
        <span class="badge badge-joined">Created</span>
      </div>
      <div>
        <div class="stat-value" style="color: var(--color-success);"><%= typeof createdCount !== 'undefined' ? createdCount : 0 %></div>
        <div class="stat-label">Sessions Created By You</div>
      </div>
    </div>

    <div class="stat-card pastel-coral">
      <div class="stat-card-header">
        <div class="stat-icon-badge">🏆</div>
        <span class="badge badge-full">Joined</span>
      </div>
      <div>
        <div class="stat-value" style="color: var(--color-danger);"><%= typeof joinedCount !== 'undefined' ? joinedCount : 0 %></div>
        <div class="stat-label">Sessions Joined By You</div>
      </div>
    </div>
  </div>

  <div class="actions-row">
    <a href="/sessions/create" class="btn btn-primary btn-lg">+ Create Sport Session</a>
    <a href="/sessions" class="btn btn-outline btn-lg">Browse All Sessions</a>
    <a href="/sessions/my-sessions" class="btn btn-outline btn-lg">My Sessions</a>
  </div>

  <h2 class="section-title mt-2">Upcoming Sessions You Can Join</h2>

  <% if (typeof recentSessions !== 'undefined' && recentSessions.length > 0) { %>
    <div class="sessions-grid">
      <% recentSessions.forEach(session => { %>
        <div class="session-card">
          <div class="flex-between mb-1">
            <span class="sport-name"><%= session.sport ? session.sport.name : 'Sport' %></span>
            <% if (session.hasJoined) { %>
              <span class="badge badge-joined">JOINED</span>
            <% } else if (session.isFull) { %>
              <span class="badge badge-full">FULL</span>
            <% } else { %>
              <span class="badge badge-active">ACTIVE</span>
            <% } %>
          </div>

          <div class="session-meta">
            <div class="session-meta-item">
              <span class="meta-icon">📅</span>
              <span><%= new Date(session.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %></span>
            </div>
            <div class="session-meta-item">
              <span class="meta-icon">⏰</span>
              <span><%= session.time %></span>
            </div>
            <div class="session-meta-item">
              <span class="meta-icon">📍</span>
              <span><%= session.venue %></span>
            </div>
            <div class="session-meta-item">
              <span class="meta-icon">👥</span>
              <span><%= session.players.length %> / <%= session.maxPlayers %> Players</span>
            </div>
          </div>

          <div class="card-footer">
            <a href="/sessions/<%= session._id %>" class="btn btn-outline btn-sm">View Details</a>
            <% if (!session.hasJoined && !session.isFull) { %>
              <form action="/sessions/<%= session._id %>/join" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-success btn-sm">Join Session</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card empty-state">
      <div class="empty-icon">📅</div>
      <p>No upcoming sessions right now. Be the first to create one!</p>
      <a href="/sessions/create" class="btn btn-primary btn-sm">Create a Session</a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
